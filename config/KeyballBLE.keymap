#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Win_1 0
#define Win_2 1
#define Mac_1 2
#define Mac_2 3
#define FUNCTION 4
#define ARROW 5
#define MOUSE 6
#define BT 7

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp AT>;
            key-positions = <8 7>;
            layers = <0>;
        };

        quotation {
            bindings = <&kp AMPERSAND>;
            key-positions = <6 5>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <4 3>;
        };

        colon {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <28 40>;
            layers = <0>;
        };

        semi_colon {
            bindings = <&kp SEMICOLON>;
            key-positions = <16 40>;
            layers = <0>;
        };

        left_kakko {
            bindings = <&kp ASTERISK>;
            key-positions = <16 17>;
            layers = <0>;
        };

        right_kakko {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <28 29>;
            layers = <0>;
        };

        at {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <10 11>;
            layers = <0>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        left_kagikakko {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 20>;
            layers = <0>;
        };

        right_kagikakko {
            bindings = <&kp BACKSLASH>;
            key-positions = <31 32>;
            layers = <0>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <17 18>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <29 30>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <41 40>;
            layers = <0>;
        };

        task_manager {
            bindings = <&kp LA(LC(DELETE))>;
            key-positions = <34 35>;
            layers = <0>;
        };

        ampersand {
            bindings = <&kp CARET>;
            key-positions = <12 13>;
            layers = <0>;
        };

        task_view {
            bindings = <&kp LG(TAB)>;
            key-positions = <22 35>;
            layers = <0>;
        };

        numlock {
            bindings = <&kp KP_NUMLOCK>;
            key-positions = <35 36>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        mitsui_email: mitsui_email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(Y) &kp A &kp M &kp A &kp M &kp O &kp T &kp O &kp DOT &kp T &kp A &kp LBKT &kp M &kp I &kp T &kp S &kp U &kp I &kp DOT &kp C &kp O &kp M>;
            label = "MITSUI_EMAIL";
        };

        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 2>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>;

            label = "BT0";
        };

        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 2>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 2>;

            label = "BT1";
        };

        bt2: bt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 2>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 2>,
                <&macro_wait_time 500>;

            label = "BT2";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Win_1 {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                  &kp T                                                      &kp Y          &kp U  &kp I      &kp O       &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G        &mkp LCLK               &kp ASTERISK          &kp H          &kp J  &kp K      &kp L       &kp MINUS
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C                  &kp V        &kp B                   &kp LEFT_PARENTHESIS  &kp N          &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 INTERNATIONAL_4  &lt 1 ENTER  &lt 5 INT_MUHENKAN      &lt 4 SPACE           &kp BACKSPACE                                &lt 7 LS(INTERNATIONAL_1)
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        Win_2 {
            bindings = <
&kp KP_NUMBER_1      &kp KP_NUMBER_2  &kp KP_NUMBER_3    &kp KP_NUMBER_4  &kp KP_NUMBER_5                                                     &kp KP_NUMBER_6  &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9   &kp KP_NUMBER_0
&kp COLON            &kp MINUS        &kp DOUBLE_QUOTES  &kp SLASH        &kp UNDERSCORE   &kp LC(LA(KP_NUMBER_0))      &kp ASTERISK          &kp EXCLAMATION  &kp COMMA          &kp HASH         &kp LEFT_BRACKET  &kp CARET
&kp INTERNATIONAL_3  &kp DOLLAR       &kp EQUAL          &kp PLUS         &kp PERCENT      &kp PERIOD                   &kp LEFT_PARENTHESIS  &kp QUESTION     &kp RIGHT_BRACKET  &kp BACKSLASH    &kp RIGHT_BRACE   &kp PIPE
&trans               &trans           &trans             &trans           &trans           &trans                       &trans                &trans                                                                 &trans
            >;
        };

        Mac_1 {
            bindings = <
&kp Q             &kp W             &kp E         &kp R                  &kp T                                                       &kp Y       &kp U  &kp I      &kp O       &kp P
&kp A             &kp S             &kp D         &kp F                  &kp G        &mkp LCLK               &kp LEFT_PARENTHESIS   &kp H       &kp J  &kp K      &kp L       &kp MINUS
&kp LEFT_SHIFT    &kp Z             &kp X         &kp C                  &kp V        &kp B                   &kp RIGHT_PARENTHESIS  &kp N       &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&kp LEFT_COMMAND  &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 6 INTERNATIONAL_4  &lt 3 ENTER  &lt 5 INT_MUHENKAN      &lt 4 SPACE            &kp DELETE                                &lt 7 LS(INTERNATIONAL_1)
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        Mac_2 {
            bindings = <
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5                                                      &kp KP_NUMBER_6  &kp KP_NUMBER_7   &kp KP_NUMBER_8    &kp KP_NUMBER_9  &kp KP_NUMBER_0
&kp PLUS         &kp MINUS        &kp ASTERISK     &kp SLASH        &kp EQUAL        &kp LC(LA(KP_NUMBER_0))      &kp LEFT_PARENTHESIS   &kp EXCLAMATION  &kp COMMA         &kp HASH           &kp AT_SIGN      &kp AMPERSAND
&kp INT_YEN      &kp DOLLAR       &kp CARET        &kp TILDE        &kp PERCENT      &kp PERIOD                   &kp RIGHT_PARENTHESIS  &kp QUESTION     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE   &kp RIGHT_BRACE
&trans           &trans           &trans           &trans           &trans           &trans                       &trans                 &trans                                                                 &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans     &trans     &trans     &trans     &trans                                &kp F1   &kp F2   &kp F3   &kp F4         &kp F5
&kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(G)  &trans             &trans  &kp F6   &kp F7   &kp F8   &kp F9         &kp F10
&trans     &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LS(LC(V))      &trans  &kp F11  &kp F12  &kp F13  &mitsui_email  &kp PAGE_UP
&trans     &trans     &trans     &trans     &trans     &trans             &trans  &trans                                    &kp PAGE_DOWN
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))     &kp UP_ARROW    &kp LC(TAB)          &trans                       &trans  &trans                  &kp LS(LC(UP_ARROW))    &trans                   &trans
&kp HOME        &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp END  &trans      &trans  &trans  &kp LS(LC(LEFT_ARROW))  &kp LS(LC(DOWN_ARROW))  &kp LS(LC(RIGHT_ARROW))  &trans
&kp LEFT_SHIFT  &kp LG(LEFT_ARROW)  &trans          &kp LG(RIGHT_ARROW)  &trans   &trans      &trans  &trans  &trans                  &trans                  &trans                   &trans
&trans          &trans              &trans          &trans               &trans   &trans      &trans  &trans                                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &trans     &trans     &mkp MB4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                   &mkp MB5
            >;
        };

        BT {
            bindings = <
&trans  &trans        &trans        &trans        &trans                              &bt0    &bt1    &bt2    &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &studio_unlock  &trans  &trans  &trans  &trans        &bt BT_CLR
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader     &trans  &trans  &trans  &trans        &bt BT_CLR_ALL
&trans  &trans        &trans        &trans        &trans  &trans      &trans          &trans                                &trans
            >;
        };
    };
};
